<%- include("../partials/header") %>
<%- include("../partials/sidebar") %>

<main class="flex-1 p-8">

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- ================= LEFT SIDE ================= -->
    <div class="lg:col-span-2 space-y-6">

      <!-- TASK CARD -->
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

        <!-- HEADER -->
        <div class="flex items-start justify-between mb-6">

          <div>
            <h1 class="text-3xl font-bold text-gray-900">
              <%= task.title %>
            </h1>

            <p class="text-gray-500 mt-1">
              <%= board.title %> • <%= workspace.title %>
            </p>
          </div>

          <span class="px-3 py-1 text-sm rounded-full bg-yellow-100 text-yellow-700">
            <%= task.status %>
          </span>

        </div>

        <!-- DESCRIPTION -->
        <div class="mb-6">

          <h3 class="text-lg font-semibold text-gray-800 mb-2">
            Description
          </h3>

          <p class="text-gray-600 leading-relaxed">
            <%= task.description %>
          </p>

        </div>

        <!-- DETAILS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

          <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
            <span class="text-sm text-gray-500 block mb-1">Priority</span>

            <span class="px-2 py-1 text-xs rounded-full
              <%= task.priority === 'high' ? 'bg-red-100 text-red-700' :
                  task.priority === 'medium' ? 'bg-yellow-100 text-yellow-700' :
                  'bg-blue-100 text-blue-700' %>">

              <%= task.priority %>

            </span>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
            <span class="text-sm text-gray-500 block mb-1">Due Date</span>

            <span class="font-semibold text-gray-800">
              <%= new Date(task.expireDate).toLocaleString() %>
            </span>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
            <span class="text-sm text-gray-500 block mb-1">Created By</span>

            <span class="font-semibold text-gray-800">
              <%= task.creator.fullName %>
            </span>
          </div>

        </div>

        <!-- ACTIONS -->
        <% if (permissions?.canEdit) { %>
          <div class="flex gap-3">

            <a href="/workspaces/<%= workspace.id %>/boards/<%= board.id %>/tasks/<%= task.id %>/edit"
               class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-lg font-medium transition">
              Edit Task
            </a>

            <% if (permissions?.canInvite) { %>
              <form action="<%= routes.task(workspace.id, board.id, task.id) %>?_method=DELETE"
                    method="POST">

                <button type="submit"
                        onclick="return confirm('Delete this task?')"
                        class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-semibold transition">
                  Delete
                </button>

              </form>
            <% } %>

          </div>
        <% } %>

      </div>

      <!-- ================= COMMENTS ================= -->
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

        <h3 class="text-xl font-bold text-gray-900 mb-4">
          Comments
        </h3>

        <div class="space-y-4">

          <% comments.forEach(comment => { %>

            <div class="comment-card border border-gray-200 rounded-lg p-4"
                data-id="<%= comment.id %>">

              <!-- HEADER -->
              <div class="flex justify-between items-start mb-2">

                <div>
                  <span class="font-semibold text-gray-800">
                    <%= comment.author.fullName %>
                  </span>

                  <span class="text-xs text-gray-500 ml-2">
                    <%= new Date(comment.createdAt).toLocaleString() %>
                  </span>
                </div>

                <% if (user.id === comment.author.id && permissions?.canEdit) { %>
                  <div class="flex gap-2">

                    <button class="px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded edit-comment-btn">
                      Edit
                    </button>

                    <form action="<%= routes.task(workspace.id, board.id, task.id) %>/comments/<%= comment.id %>?_method=DELETE"
                          method="POST">

                      <button onclick="return confirm('Delete?')"
                              class="px-2 py-1 text-xs bg-red-100 text-red-700 rounded">
                        Delete
                      </button>

                    </form>

                  </div>
                <% } %>

              </div>

              <!-- CONTENT (INLINE EDIT TARGET) -->
              <div class="comment-content text-gray-600">
                <%= comment.content %>
              </div>

              <!-- INLINE EDIT FORM (hidden by default, JS will use it) -->
              <% if (user.id === comment.author.id) { %>

                <form class="comment-edit-form hidden mt-3"
                      action="<%= routes.task(workspace.id, board.id, task.id) %>/comments/<%= comment.id %>?_method=PATCH"
                      method="POST">

                  <textarea name="content"
                            class="w-full border border-gray-300 rounded-lg p-2 mb-2"><%= comment.content %></textarea>

                  <div class="flex gap-2">

                    <button type="submit"
                            class="bg-indigo-600 text-white px-3 py-1 rounded-lg text-sm">
                      Save
                    </button>

                    <button type="button"
                            class="bg-gray-200 px-3 py-1 rounded-lg text-sm cancel-edit-btn">
                      Cancel
                    </button>

                  </div>

                </form>

              <% } %>

            </div>

          <% }) %>

        </div>

        <!-- COMMENT FORM -->
        <div class="mt-6">

          <h3 class="text-lg font-semibold mb-2">
            Add Comment
          </h3>

          <form action="<%= routes.task(workspace.id, board.id, task.id) %>/comments"
                method="POST"
                class="space-y-3">

            <textarea name="content"
                      placeholder="Write a comment..."
                      required
                      class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-indigo-500"></textarea>

            <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-semibold transition">
              Comment
            </button>

          </form>

        </div>

      </div>

    </div>

    <!-- ================= RIGHT SIDE ================= -->
    <div class="space-y-6">

      <!-- ASSIGNED USERS CARD -->
      <div class="assigned-card bg-white border border-gray-200 rounded-xl p-4 shadow-sm">

        <div class="assigned-header flex items-center justify-between mb-3">

          <h3 class="font-semibold text-gray-900">
            Assigned Users
          </h3>

          <% if (permissions?.canEdit || permissions?.canAssign) { %>
            <form action="<%= routes.task(workspace.id, board.id, task.id) %>/assign"
                  method="POST"
                  class="flex gap-2">

              <select name="userId"
                      class="border border-gray-300 rounded-lg px-2 py-1 text-sm">

                <% users.forEach(user => { %>
                  <option value="<%= user.id %>">
                    <%= user.fullName %>
                  </option>
                <% }) %>

              </select>

              <button type="submit"
                      class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1 rounded-lg text-sm">
                +
              </button>

            </form>
          <% } %>

        </div>

        <!-- SCROLL AREA -->
        <div class="max-h-60 overflow-y-auto space-y-2 pr-1">

          <% assignees.forEach(assignee => { %>

            <div class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50">

              <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-sm font-bold text-indigo-600">
                <%= assignee.fullName.charAt(0) %>
              </div>

              <span class="text-sm text-gray-700">
                <%= assignee.fullName %>
              </span>

            </div>

          <% }) %>

        </div>

      </div>

      <!-- ACTIVITY LOG -->
      <div class="activity-section mt-6">
        
        <h3 class="text-lg font-semibold mb-2">
          Activity Log
        </h3>

        <!-- SCROLL CONTAINER -->
        <div class="max-h-80 overflow-y-auto pr-2 space-y-3 border border-gray-200 rounded-lg p-3 bg-white">

          <% activities.forEach(activity => { %>

            <div class="flex gap-3">

              <!-- DOT -->
              <div class="w-2 h-2 mt-2 rounded-full bg-indigo-500 flex-shrink-0"></div>

              <!-- CONTENT -->
              <div class="flex-1">

                <div class="text-sm text-gray-800">
                  <strong><%= activity.actor.fullName %></strong>

                  <% if (activity.action === "comment_created") { %>
                    added a comment
                  <% } else if (activity.action === "comment_updated") { %>
                    updated a comment
                  <% } else if (activity.action === "comment_deleted") { %>
                    deleted a comment
                  <% } else if (activity.action === "task_assigned") { %>
                    assigned a user to the task
                  <% } %>
                </div>

                <div class="text-xs text-gray-400">
                  <%= new Date(activity.createdAt).toLocaleString() %>
                </div>

              </div>

            </div>

          <% }) %>

          <button
            id="loadMoreActivities"
            data-task="<%= task.id %>"
            data-workspace="<%= workspace.id %>"
            data-board="<%= board.id %>"
            data-offset="<%= activities.length %>"
            class="w-full mt-4 py-2 text-sm bg-gray-100 hover:bg-gray-200 rounded-lg">
            Load more activities
          </button>
        </div>
      </div>
    </div>

  </div>

</main>

<%- include("../partials/footer") %>