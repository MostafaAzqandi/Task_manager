<!-- views/tasks/show.ejs -->

<%- include("../partials/header") %>

  <%- include("../partials/sidebar") %>

    <main class="main-content">

      <div class="task-page">

        <div class="task-main-card">

          <div class="task-header">

            <div>

              <h1 class="single-task-title">
                <%= task.title %>
              </h1>

              <p class="single-task-meta">
                <%= board.title %> • <%= workspace.title %>
              </p>

            </div>

            <span class="task-status status-progress">
              <%= task.status %>
            </span>

          </div>

          <div class="task-section">

            <h3>
              Description
            </h3>

            <p class="single-task-description">
              <%= task.description %>
            </p>

          </div>

          <div class="task-details-grid">

            <div class="task-detail-box">

              <span class="detail-label">
                Priority
              </span>

              <span class="task-priority <%= task.priority %>-priority">
                <%= task.priority %>
              </span>

            </div>

            <div class="task-detail-box">

              <span class="detail-label">
                Due Date
              </span>

              <span class="detail-value">
                June 5, 2026
              </span>

            </div>

            <div class="task-detail-box">

              <span class="detail-label">
                Created By
              </span>

              <span class="detail-value">
                <%= task.creator.fullName %>
              </span>

            </div>

          </div>

          <div class="task-actions">

            <a href="/workspaces/<%= workspace.id %>/boards/<%= board.id %>/tasks/<%= task.id %>/edit"
              class="secondary-btn">
              Edit Task
            </a>

            <form action="<%= routes.task(workspace.id, board.id, task.id) %>?_method=DELETE" method="POST">

              <button type="submit" class="danger-btn" onclick="return confirm('Delete this task?')">
                Delete
              </button>

            </form>
          </div>

        </div>

        <aside class="task-sidebar">

          <div class="assigned-card">

            <div class="assigned-header">

              <h3>
                Assigned Users
              </h3>

              <form action="<%= routes.task(workspace.id, board.id, task.id) %>/assign" method="POST"
                class="assign-form">

                <select name="userId" class="assign-select">

                  <% users.forEach(user=> { %>

                    <option value="<%= user.id %>">

                      <%= user.fullName %>

                    </option>

                    <% }) %>

                </select>

                <button type="submit" class="primary-btn small-btn">
                  +
                </button>

              </form>

            </div>

            <ul class="assigned-list">
              <% assignees.forEach(assignee=> { %>
                <li class="assigned-user">
                  <div class="avatar">
                    M
                  </div>

                  <span>
                    <%= assignee.fullName %>
                  </span>
                </li>
                <% }) %>
                  </li>

            </ul>

          </div>

        </aside>

      </div>
      <div class="comments-section">

        <h3>Comments</h3>

        <div class="comments-list">

          <% comments.forEach(comment=> { %>

            <div class="comment-card">

              <div class="comment-header">

                <span class="comment-author">
                  <%= comment.author.fullName %>
                </span>

                <span class="comment-date">
                  <%= comment.createdAt %>
                </span>

              </div>

              <div class="comment-content">
                <%= comment.content %>
              </div>

            </div>

            <% }) %>

        </div>

      </div>
    </main>

    <%- include("../partials/footer") %>