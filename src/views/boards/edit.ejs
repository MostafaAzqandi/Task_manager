<!-- views/boards/edit.ejs -->

<%- include("../partials/header") %>

<%- include("../partials/sidebar") %>

<main class="main-content">

  <div class="form-container">

    <div class="form-header">

      <h1>
        Edit Board
      </h1>

      <p>
        Update "<%= board.title %>" board informations
      </p>

    </div>

    <form action="<%= routes.board(workspace.id, board.id) %>?_method=PATCH" method="POST">
       
      <div class="form-group">

        <label>
          Board Title
        </label>

        <input
          type="text"
          name="title"
          value="<%= board.title %>"
          placeholder="Board title"
        >

      </div>

      <div class="form-group">

        <label>
          Description
        </label>

        <textarea
          name="description"
          rows="5"
          placeholder="Board description"
        ><%= board.description %></textarea>

      </div>

      <div class="form-actions">

        <button
          type="submit"
          class="primary-btn"
        >
          Save Changes
        </button>

        <a
          href="<%= routes.board(workspace.id, board.id) %>"
          class="secondary-btn"
        >
          Cancel
        </a>

      </div>

    </form>

  </div>

</main>

<%- include("../partials/footer") %>