<!-- views/workspaces/create.ejs -->

<%- include("../partials/header") %>

<%- include("../partials/sidebar") %>

<main class="main-content">

  <div class="form-container">

    <div class="form-header">

      <h1>
        Create Workspace
      </h1>

      <p>
        Create a new board for <%= workspace.title %>
      </p>

    </div>

    <form
      action="/workspaces/<%= workspace.id %>/boards"
      method="POST"
    >

      <div class="form-group">

        <label>
          Board Title
        </label>

        <input
          type="text"
          name="title"
          placeholder="Enter board title"
        >

      </div>

      <div class="form-group">

        <label>
          Description
        </label>

        <textarea
          name="description"
          rows="6"
          placeholder="Describe this board"
        ></textarea>

      </div>

      <div class="form-actions">

        <button
          type="submit"
          class="primary-btn"
        >
          Create board
        </button>

        <a
          href="/workspaces/<%= workspace.id %>/boards"
          class="secondary-btn"
        >
          Cancel
        </a>

      </div>

    </form>

  </div>

</main>

<%- include("../partials/footer") %>