<!-- views/boards/show.ejs -->

<%- include("../partials/header") %>

<%- include("../partials/sidebar") %>

<main class="main-content">

  <div class="board-banner">

    <div>

      <h1 class="board-title">
        <%= board.title %>
      </h1>

      <p class="board-meta">
        <%= taskCount %> Tasks • Workspace: <%= workspace.title %>
      </p>

    </div>

    <div class="board-actions">

      <a
        href="#"
        class="secondary-btn"
      >
        Edit Board
      </a>

      <button class="danger-btn">
        Delete Board
      </button>

    </div>

  </div>

  <section class="tasks-section">

    <div class="section-header">

      <h2>
        Tasks
      </h2>

      <a href="#" class="primary-btn">
        + New Task
      </a>

    </div>

    <div class="tasks-grid">
      <% tasks.forEach(task => { %>
      <div class="task-card">

        <div class="task-top">

          <h3>
            <%= task.title %>
          </h3>

          <span class="task-status status-progress">
            <%= task.status %>
          </span>

        </div>

        <p class="task-description">
          <%= task.description %>
        </p>

        <div class="task-footer">

          <span class="task-priority high-priority">
            High
          </span>

          <a href="/workspaces/<%= workspace.id %>/boards/<%= board.id %>/tasks/<%= task.id %>">
            Open →
          </a>

        </div>

      </div>
      <% }) %>
    </div>

  </section>

</main>

<%- include("../partials/footer") %>