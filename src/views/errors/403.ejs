<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    403 Forbidden
  </title>

  <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen bg-gray-100 flex items-center justify-center px-4">

  <div class="w-full max-w-md">

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-10 text-center">

      <!-- ERROR CODE -->
      <h1 class="text-7xl font-extrabold text-red-500 mb-4">
        403
      </h1>

      <!-- TITLE -->
      <h2 class="text-2xl font-bold text-gray-900 mb-3">
        Permission Denied
      </h2>

      <!-- MESSAGE -->
      <p class="text-gray-500 mb-8 leading-relaxed">
        You do not have permission
        to access this page or resource.
      </p>

      <!-- BUTTON -->
      <a
        href="/workspaces"
        class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition"
      >
        Back to Dashboard
      </a>

    </div>

  </div>

</body>

</html>