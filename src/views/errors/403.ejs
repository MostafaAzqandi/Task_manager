<!-- views/errors/403.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Unauthorized Access
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    rel="stylesheet"
    href="/css/errors.css"
  >

</head>

<body>

  <div class="error-page">

    <div class="error-card">

      <div class="error-code">
        403
      </div>

      <h1 class="error-title">
        Access Denied
      </h1>

      <p class="error-text">

        You do not have permission
        to access this page or resource.

      </p>

      <a
        href="/workspaces"
        class="home-btn"
      >
        Back to Dashboard
      </a>

    </div>

  </div>

</body>

</html>