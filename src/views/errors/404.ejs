<!-- views/errors/404.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Page Not Found
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    rel="stylesheet"
    href="/css/errors.css"
  >

</head>

<body>

  <div class="error-page">

    <div class="error-card">

      <div class="error-code">
        404
      </div>

      <h1 class="error-title">
        Page Not Found
      </h1>

      <p class="error-text">

        The page you are looking for
        does not exist or may have
        been moved.

      </p>

      <a
        href="/workspaces"
        class="home-btn"
      >
        Back to Dashboard
      </a>

    </div>

  </div>

</body>

</html>