<%- include("../partials/header") %>
<%- include("../partials/sidebar") %>

<main class="flex-1 p-8">

  <!-- HEADER -->
  <div class="flex items-center justify-between mb-8">

    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        Your Workspaces
      </h1>

      <p class="text-gray-500 mt-1">
        Manage your projects and teams
      </p>
    </div>

    <a href="/workspaces/new"
       class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-lg font-semibold transition">
      + New Workspace
    </a>

  </div>

  <!-- GRID -->
  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

    <% workspaces.forEach(workspace => { %>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition">

        <!-- TOP -->
        <div class="flex items-start justify-between mb-4">

          <h2 class="text-xl font-bold text-gray-900">
            <%= workspace.title %>
          </h2>

          <span class="text-xs px-2 py-1 rounded-full bg-indigo-100 text-indigo-700 font-medium">
            <%= workspace.WorkspaceMember?.role || "guest" %>
          </span>

        </div>

        <p class="text-gray-500 text-sm mb-6">
          <%= workspace.description || "No description" %>
        </p>

        <!-- FOOTER -->
        <div class="flex items-center justify-between text-sm">

          <span class="text-gray-500">
            <%= workspace.Boards.length %> Boards
          </span>

          <a href="/workspaces/<%= workspace.id %>"
             class="text-indigo-600 font-semibold hover:text-indigo-800">
            Open →
          </a>

        </div>

      </div>

    <% }) %>

  </section>

</main>

<%- include("../partials/footer") %>