<!-- views/workspaces/create.ejs -->

<%- include("../partials/header") %>

<%- include("../partials/sidebar") %>

<main class="main-content">

  <div class="form-container">

    <div class="form-header">

      <h1>
        Create Workspace
      </h1>

      <p>
        Start a new workspace for your team or project
      </p>

    </div>

    <form
      action="/workspaces"
      method="POST"
    >

      <div class="form-group">

        <label>
          Workspace Title
        </label>

        <input
          type="text"
          name="title"
          placeholder="Enter workspace title"
        >

      </div>

      <div class="form-group">

        <label>
          Description
        </label>

        <textarea
          name="description"
          rows="6"
          placeholder="Describe this workspace"
        ></textarea>

      </div>

      <div class="form-actions">

        <button
          type="submit"
          class="primary-btn"
        >
          Create Workspace
        </button>

        <a
          href="/workspaces"
          class="secondary-btn"
        >
          Cancel
        </a>

      </div>

    </form>

  </div>

</main>

<%- include("../partials/footer") %>