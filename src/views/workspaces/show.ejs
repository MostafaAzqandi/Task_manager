<%- include("../partials/header") %>
  <%- include("../partials/sidebar") %>

    <main class="flex-1 p-8">

      <!-- WORKSPACE HEADER -->
      <div class="flex items-start justify-between mb-8 bg-white border border-gray-200 rounded-xl p-6">

        <!-- LEFT INFO -->
        <div>
          <h1 class="text-3xl font-bold text-gray-900">
            <%= workspace.title %>
              <span class="text-gray-400 text-xl">/ <%= workspace.visibility %></span>
          </h1>

          <p class="text-gray-500 mt-2">
            <%= totalBoards %> Boards • <%= memberCount %> Members
          </p>
        </div>

        <!-- RIGHT ACTIONS -->
        <% if (permissions?.canEdit) { %>

          <div class="flex flex-col gap-3 w-72">

            <!-- INVITE -->
            <% if (permissions?.canInvite) { %>
              <form action="/workspaces/<%= workspace.id %>/invite" method="POST"
                class="flex flex-col gap-2 bg-gray-50 border border-gray-200 p-4 rounded-lg">

                <label class="text-sm font-semibold text-gray-700">
                  Invite users to this workspace
                </label>

                <input type="email" name="email" placeholder="User email"
                  class="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">

                <button type="submit"
                  class="bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg font-semibold transition">
                  Invite
                </button>

              </form>
            <% } %>

            <!-- ADMIN ACTIONS -->
            <% if (permissions?.canDelete) { %>

              <a href="/workspaces/<%= workspace.id %>/edit"
                class="bg-gray-100 hover:bg-gray-200 text-gray-800 py-2 rounded-lg text-center font-medium transition">
                Edit Workspace
              </a>

              <form action="/workspaces/<%= workspace.id %>?_method=DELETE" method="POST">

                <button type="submit" onclick="return confirm('Delete this workspace?')"
                  class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg font-semibold transition">
                  Delete
                </button>

              </form>

              <% } %>

          </div>

          <% } %>

      </div>

      <!-- BOARDS HEADER -->
      <div class="flex items-center justify-between mb-6">

        <h2 class="text-2xl font-bold text-gray-900">
          Boards
        </h2>

        <% if (permissions?.canInvite) { %>
          <a href="/workspaces/<%= workspace.id %>/boards/new"
            class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-semibold transition">
            + New Board
          </a>
          <% } %>

      </div>

      <!-- BOARDS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <% boards.forEach(board=> { %>

          <div class="bg-white border border-gray-200 rounded-xl p-5 hover:shadow-md transition">

            <h3 class="text-lg font-bold text-gray-900 mb-2">
              <%= board.title %>
            </h3>

            <p class="text-gray-500 text-sm mb-4">
              <%= board.description || "No description" %>
            </p>

            <div class="flex items-center justify-between text-sm">

              <span class="text-gray-500">
                <%= board.Tasks.length %> Tasks
              </span>

              <a href="/workspaces/<%= workspace.id %>/boards/<%= board.id %>"
                class="text-indigo-600 font-semibold hover:text-indigo-800">
                Open →
              </a>

            </div>

          </div>

          <% }) %>

      </div>
      <div class="flex gap-2 mt-6">

        <% if(currentPage> 1) { %>
          <a href="?page=<%= currentPage - 1 %>">
            Prev
          </a>
        <% } %>

        <% for(let i=Math.max(1, currentPage - 2); i <=Math.min(totalPages, currentPage + 2); i++) { %>

          <a href="?page=<%= i %>" class="<%= currentPage === i ? 'font-bold' : '' %>">
            <%= i %>
          </a>

        <% } %>

        <% if(currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>">
            Next
          </a>
        <% } %>

      </div>
    </main>

    <%- include("../partials/footer") %>